{
  "name": "@blackbelt-technology/pi-dashboard-flows-plugin",
  "version": "0.5.1",
  "description": "Flow rendering plugin for pi-dashboard — pi-flows event reaction (FlowDashboard, FlowAgentCard, FlowArchitect, etc.)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/flows-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./reducer": {
      "types": "./src/reducer.ts",
      "default": "./src/reducer.ts"
    }
  },
  "files": [
    "src/"
  ],
  "//pi-dashboard-plugin-deferred-claims": "session-card-badge (FlowActivityBadge) and session-card-action-bar (SessionFlowActions) are deferred until migrate-flows-jsx-to-slots adapts those components to accept {session} and pull app state from context. Until then they remain wired via direct JSX in SessionCard.tsx.",
  "pi-dashboard-plugin": {
    "id": "flows",
    "displayName": "Flows",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "claims": []
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-shared": "workspace:*",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "dagre-d3-es": "^7.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
